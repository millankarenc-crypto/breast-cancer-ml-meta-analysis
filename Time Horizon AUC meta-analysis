  cat("----------------------------------------\n")
  
  # List individual studies
  for(j in 1:ma_result$k) {
    auc_val <- exp(ma_result$TE[j]) / (1 + exp(ma_result$TE[j]))
    lower_val <- exp(ma_result$lower[j]) / (1 + exp(ma_result$lower[j]))
    upper_val <- exp(ma_result$upper[j]) / (1 + exp(ma_result$upper[j]))
    cat(paste("- ", ma_result$studlab[j], ": ", 
              sprintf("%.3f", auc_val), " [", 
              sprintf("%.3f", lower_val), ", ", 
              sprintf("%.3f", upper_val), "]\n", sep=""))
  }
  
  cat(paste("\n**", re_label, "**: ", 
            sprintf("%.3f", exp(ma_result$TE.random)/(1+exp(ma_result$TE.random))), 
            " [", 
            sprintf("%.3f", exp(ma_result$lower.random)/(1+exp(ma_result$lower.random))), 
            ", ", 
            sprintf("%.3f", exp(ma_result$upper.random)/(1+exp(ma_result$upper.random))), 
            "]\n", sep = ""))
  
  # Format Cochran's Q p-value for console
  if (!is.null(ma_result$cochran_p)) {
    if (ma_result$cochran_p < 0.001) {
      cochran_console <- sprintf("Cochran's Q = %.2f (p < 0.001)", ma_result$cochran_q)
    } else {
      cochran_console <- sprintf("Cochran's Q = %.2f (p = %.4f)", ma_result$cochran_q, ma_result$cochran_p)
    }
  } else {
    if (ma_result$pval.Q < 0.001) {
      cochran_console <- sprintf("Cochran's Q = %.2f (p < 0.001)", ma_result$Q)
    } else {
      cochran_console <- sprintf("Cochran's Q = %.2f (p = %.4f)", ma_result$Q, ma_result$pval.Q)
    }
  }
  
  cat(paste("\n**Heterogeneity**: I² = ", sprintf("%.1f%%", ma_result$I2), 
            ", τ² = ", sprintf("%.4f", ma_result$tau2), 
            ", ", cochran_console, "\n", sep=""))
  
  cat("\n---\n\n")
}

# Print long-term studies separately
if(!is.null(long_term_studies)) {
  cat("**long-term (k = 2) - No meta-analysis performed (insufficient studies)**\n")
  cat("----------------------------------------\n")
  for(j in 1:nrow(long_term_studies)) {
    cat(paste("- ", long_term_studies$Study[j], ": ", 
              sprintf("%.3f", long_term_studies$AUC[j]), " [", 
              sprintf("%.3f", long_term_studies$LowerCI[j]), ", ", 
              sprintf("%.3f", long_term_studies$UpperCI[j]), "]\n", sep=""))
  }
  cat("\n")
}

# ============================================================================
# CREATE SUMMARY CSV FILE
# ============================================================================

summary_data <- data.frame()
for(horizon in names(meta_results)) {
  ma_result <- meta_results[[horizon]]
  
  re_label <- switch(horizon,
                     "short-term" = "RE for short-term",
                     "medium-term" = "RE for mid-term",
                     paste("RE for", horizon)
  )
  
  # Get Cochran's Q and p-value
  if (!is.null(ma_result$cochran_q)) {
    cochran_q <- ma_result$cochran_q
    cochran_p <- ma_result$cochran_p
  } else {
    cochran_q <- ma_result$Q
    cochran_p <- ma_result$pval.Q
  }
  
  summary_row <- data.frame(
    Horizon = horizon,
    Meta_Analysis_Performed = "Yes",
    Number_of_Studies = ma_result$k,
    Pooled_AUC = sprintf("%.3f", exp(ma_result$TE.random)/(1+exp(ma_result$TE.random))),
    CI_Lower = sprintf("%.3f", exp(ma_result$lower.random)/(1+exp(ma_result$lower.random))),
    CI_Upper = sprintf("%.3f", exp(ma_result$upper.random)/(1+exp(ma_result$upper.random))),
    I_Squared = sprintf("%.1f%%", ma_result$I2),
    Tau_Squared = sprintf("%.4f", ma_result$tau2),
    Cochran_Q = sprintf("%.2f", cochran_q),
    P_value = ifelse(cochran_p < 0.001, "<0.001", sprintf("%.4f", cochran_p)),
    stringsAsFactors = FALSE
  )
  
  summary_data <- rbind(summary_data, summary_row)
}

# Add long-term to summary without MA
if(!is.null(long_term_studies)) {
  summary_row <- data.frame(
    Horizon = "long-term",
