    CI_Upper = "N/A",
    I_Squared = "N/A",
    Tau_Squared = "N/A",
    Cochran_Q = "N/A",
    P_value = "N/A",
    stringsAsFactors = FALSE
  )
  
  summary_data <- rbind(summary_data, summary_row)
}

write.csv(summary_data, "horizon_subgroup_summary.csv", row.names = FALSE)
