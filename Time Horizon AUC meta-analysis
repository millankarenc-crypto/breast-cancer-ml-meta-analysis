# Load necessary libraries
library(meta)
library(metafor)
library(dplyr)
library(forestplot)
library(grid)

# Read the data
data <- read.csv("meta_future.csv", stringsAsFactors = FALSE)

# Clean and prepare the data
data$AUC <- as.numeric(data$AUC)
data$LowerCI <- as.numeric(data$LowerCI)
data$UpperCI <- as.numeric(data$UpperCI)
data$SE <- (data$UpperCI - data$LowerCI) / (2 * 1.96)

# Calculate logit transformed AUC and its variance for meta-analysis
data$logitAUC <- log(data$AUC / (1 - data$AUC))
data$var_logitAUC <- with(data, (SE^2) / (AUC^2 * (1 - AUC)^2))

# ============================================================================
# PERFORM META-ANALYSIS FOR EACH HORIZON BIN SUBGROUP
# Skip long-term if fewer than 3 studies
# ============================================================================

# Only include horizons that actually exist in the data
horizon_levels <- unique(data$HorizonBin)
cat("Found horizons in data:", paste(horizon_levels, collapse=", "), "\n\n")

meta_results <- list()
long_term_studies <- NULL

for(horizon in horizon_levels) {
  subset_data <- data[data$HorizonBin == horizon, ]
  
  if(nrow(subset_data) > 0) {
    # Skip meta-analysis for long-term if fewer than 3 studies
    if(horizon == "long-term" && nrow(subset_data) < 3) {
      cat(sprintf("%s: Skipping MA (only %d studies, need at least 3)\n", 
                  horizon, nrow(subset_data)))
      long_term_studies <- subset_data
      next
    }
    
    # Perform meta-analysis using metagen
    ma_result <- metagen(TE = logitAUC, 
                         seTE = sqrt(var_logitAUC), 
                         studlab = Study,
                         data = subset_data,
                         sm = "PLOGIT",
                         backtransf = TRUE,
                         method.random.ci = "HK",
                         method.tau = "REML",
                         prediction = TRUE,
                         common = FALSE,
                         random = TRUE)
    
    # Recalculate I² correctly using rma()
    rma_correct <- rma(yi = AUC, sei = SE, data = subset_data, method = "REML")
    
    # Override the incorrect I² from metagen with correct one from rma
    ma_result$I2 <- rma_correct$I2
    ma_result$lower.I2 <- NULL
    ma_result$upper.I2 <- NULL
    ma_result$tau2 <- rma_correct$tau2
    ma_result$cochran_q <- rma_correct$QE
    ma_result$cochran_p <- rma_correct$QEp
    
    cat(sprintf("%s: Corrected I² = %.1f%% (based on %d studies)\n", 
                horizon, rma_correct$I2, nrow(subset_data)))
    
    meta_results[[horizon]] <- ma_result
  }
}

# ============================================================================
# PREPARE DATA FOR FOREST PLOT
# ============================================================================

# Create data frame for plotting
plot_data <- data.frame(
  label = character(),
  auc = numeric(),
  lower = numeric(),
  upper = numeric(),
  is_summary = logical(),
  stringsAsFactors = FALSE
)

for(i in 1:length(meta_results)) {
  horizon <- names(meta_results)[i]
  ma_result <- meta_results[[horizon]]
  
  # Create RE label based on horizon
  re_label <- switch(horizon,
                     "short-term" = "RE for Short-term",
                     "medium-term" = "RE for Mid-term",
                     paste("RE for", horizon)
  )
  
  # Add subgroup header
  plot_data <- rbind(plot_data, data.frame(
    label = paste(horizon, "(k =", ma_result$k, ")"),
    auc = NA,
    lower = NA,
    upper = NA,
    is_summary = TRUE,
    stringsAsFactors = FALSE
  ))
  
  # Add individual studies
  for(j in 1:ma_result$k) {
    auc_val <- exp(ma_result$TE[j]) / (1 + exp(ma_result$TE[j]))
    lower_val <- exp(ma_result$lower[j]) / (1 + exp(ma_result$lower[j]))
    upper_val <- exp(ma_result$upper[j]) / (1 + exp(ma_result$upper[j]))
    
    plot_data <- rbind(plot_data, data.frame(
      label = ma_result$studlab[j],
      auc = auc_val,
      lower = lower_val,
      upper = upper_val,
      is_summary = FALSE,
      stringsAsFactors = FALSE
    ))
  }
  
  # Add random effects model row
  auc_re <- exp(ma_result$TE.random) / (1 + exp(ma_result$TE.random))
  lower_re <- exp(ma_result$lower.random) / (1 + exp(ma_result$lower.random))
  upper_re <- exp(ma_result$upper.random) / (1 + exp(ma_result$upper.random))
  
  plot_data <- rbind(plot_data, data.frame(
    label = re_label,
    auc = auc_re,
    lower = lower_re,
    upper = upper_re,
    is_summary = TRUE,
    stringsAsFactors = FALSE
  ))
  
  # Add simplified heterogeneity information row
  if (!is.null(ma_result$cochran_p)) {
    if (ma_result$cochran_p < 0.001) {
      cochran_text <- sprintf("Q = %.2f (p < 0.001)", ma_result$cochran_q)
    } else {
      cochran_text <- sprintf("Q = %.2f (p = %.4f)", ma_result$cochran_q, ma_result$cochran_p)
    }
  } else {
    if (ma_result$pval.Q < 0.001) {
      cochran_text <- sprintf("Q = %.2f (p < 0.001)", ma_result$Q)
    } else {
      cochran_text <- sprintf("Q = %.2f (p = %.4f)", ma_result$Q, ma_result$pval.Q)
    }
  }
  
  het_text <- sprintf("I² = %.1f%%, τ² = %.4f, %s", 
                      ma_result$I2, ma_result$tau2, cochran_text)
  
  plot_data <- rbind(plot_data, data.frame(
    label = het_text,
    auc = NA,
    lower = NA,
    upper = NA,
    is_summary = FALSE,
    stringsAsFactors = FALSE
  ))
  
  # Add separator row (except after last subgroup)
  if(i < length(meta_results)) {
    plot_data <- rbind(plot_data, data.frame(
      label = " ",
      auc = NA,
      lower = NA,
      upper = NA,
      is_summary = FALSE,
      stringsAsFactors = FALSE
    ))
  }
}

# Create AUC with CI column
plot_data$auc_ci <- ifelse(is.na(plot_data$auc), "",
                           sprintf("%.3f [%.3f, %.3f]", 
                                   plot_data$auc, plot_data$lower, plot_data$upper))

# Create label text matrix
labeltext_matrix <- cbind(plot_data$label, plot_data$auc_ci)

# ============================================================================
# FIND APPROPRIATE X-AXIS LIMITS
# ============================================================================

# Calculate min and max values for the x-axis
all_auc_values <- plot_data$auc[!is.na(plot_data$auc)]
all_lower_values <- plot_data$lower[!is.na(plot_data$lower)]
all_upper_values <- plot_data$upper[!is.na(plot_data$upper)]
all_values <- c(all_auc_values, all_lower_values, all_upper_values)

# Set x-axis limits
x_min <- max(0.5, min(all_values, na.rm = TRUE) - 0.05)
x_max <- min(1.0, max(all_values, na.rm = TRUE) + 0.05)

# Round to nearest 0.05 for clean axis ticks
x_min <- floor(x_min * 20) / 20
x_max <- ceiling(x_max * 20) / 20

# Ensure we have reasonable limits
x_min <- max(0.5, x_min)
x_max <- min(1.0, x_max)

# Create appropriate x-ticks
x_ticks <- seq(round(x_min, 2), round(x_max, 2), by = 0.05)

# Ensure we include 0.5 as a tick if it's within range
if(0.5 >= x_min && 0.5 <= x_max && !(0.5 %in% x_ticks)) {
  x_ticks <- sort(c(x_ticks, 0.5))
}

cat(paste("Setting x-axis limits to:", x_min, "-", x_max, "\n"))
cat(paste("X-axis ticks:", paste(x_ticks, collapse=", "), "\n"))

# ============================================================================
# CREATE FOREST PLOT
# ============================================================================

base_fp <- forestplot(
  labeltext = labeltext_matrix,
  mean = plot_data$auc,
  lower = plot_data$lower,
  upper = plot_data$upper,
  clip = c(x_min, x_max),
  vertices = TRUE,
  xlog = FALSE,
  boxsize = 0.2,
  col = fpColors(box = "royalblue", line = "darkblue", summary = "royalblue"),
  is.summary = plot_data$is_summary,
  xlab = "AUC",
  zero = 0.5,
  grid = TRUE,
  title = "Subgroup Meta-analysis by Prediction Horizon: AUC of Breast Cancer Risk Prediction Models",
  xticks = x_ticks,
  graph.pos = 3,
  txt_gp = fpTxtGp(
    label = gpar(cex = 0.85),
    summary = gpar(cex = 0.85, fontface = "bold"),
    xlab = gpar(cex = 1)
  )
)

# Apply the styling
final_plot <- base_fp %>%
  fp_set_style(box = "hotpink3", line = "lightsteelblue4", summary = "red4") %>%
  fp_set_zebra_style("#f9f9f9")

# Display the plot
print(final_plot)

# Save as PDF
pdf("horizon_bin_forest_plot.pdf", width = 14, height = 12)
print(final_plot)
dev.off()
cat("\n✅ Forest plot saved as 'horizon_bin_forest_plot.pdf'\n")


# Display the plot
print(final_plot)

